{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "go-no-go",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "spike/go-no-go",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
