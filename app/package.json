{
  "name": "private-ledger",
  "private": true,
  "version": "0.1.0",
  "description": "Separate business and personal spending from a bank CSV. Raw transactions are labeled on-device; the cloud only gets totals.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --port 5174 --strictPort",
    "preview:hosting": "node scripts/serve-hosting.mjs",
    "test": "npm run test:csv && npm run test:g8 && npm run test:g9",
    "test:csv": "node --experimental-strip-types scripts/csv.test.ts",
    "test:g8": "node --experimental-strip-types scripts/g8.ts",
    "test:g9": "node --experimental-strip-types scripts/g9.ts"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "firebase": "13.2.0",
    "lucide-react": "1.81.0",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.4.0"
  }
}
