# Copy this file to .env.local and fill it in. Never commit .env.local.
# Values: Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration (Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Production App Check provider. Set ONE of these; the site key is public by design.
# Recommended: a score-based reCAPTCHA Enterprise key (Google Cloud console > Security > reCAPTCHA),
# registered under Firebase console > Security > App Check > Apps > your web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Alternative: a reCAPTCHA v3 site key registered in App Check the same way.
VITE_RECAPTCHA_V3_SITE_KEY=

# The App Check DEBUG token does NOT go in this file. Put it in .env.development.local:
#
#   VITE_APPCHECK_DEBUG_TOKEN=<token from App Check > Apps > your web app > Manage debug tokens>
#
# Vite reads .env.development.local only for `vite dev`, never for `vite build`,
# so the debug token cannot end up in a deployed bundle.
